<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.javafx_hibernate.controller.PrestamosController"
      spacing="10">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Registrar Préstamo" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="8">
        <Label text="Libro disponible:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboLibro" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Socio:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboSocio" prefWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <Button text="Registrar Préstamo" onAction="#onRegistrarPrestamo" styleClass="primary"/>

    <Separator/>

    <Label text="Préstamos Activos" style="-fx-font-weight: bold;"/>

    <TableView fx:id="tablaPrestamos" prefHeight="250">
        <columns>
            <TableColumn fx:id="colLibro" text="Libro" prefWidth="200"/>
            <TableColumn fx:id="colSocio" text="Socio" prefWidth="200"/>
            <TableColumn fx:id="colFechaPrestamo" text="Fecha Préstamo" prefWidth="150"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Devolver Libro" onAction="#onDevolverLibro"/>
        <Button text="Historial de socio" onAction="#onVerHistorial"/>
        <Button text="Actualizar listas" onAction="#onActualizarListas"/>
    </HBox>

</VBox>