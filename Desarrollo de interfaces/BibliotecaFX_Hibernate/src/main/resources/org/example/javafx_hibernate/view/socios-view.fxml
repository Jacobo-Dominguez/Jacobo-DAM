<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.javafx_hibernate.controller.SociosController"
      spacing="10">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Registro de Socios" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="8">
        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" prefWidth="200" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Dirección:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtDireccion" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Teléfono:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTelefono" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <Button text="Guardar Socio" onAction="#onGuardarSocio" styleClass="primary"/>

    <Separator/>

    <Label text="Lista de Socios" style="-fx-font-weight: bold;"/>

    <TableView fx:id="tablaSocios" prefHeight="250">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200"/>
            <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="180"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="150"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Eliminar Socio" onAction="#onEliminarSocio"/>
        <Button text="Buscar por nombre" onAction="#onBuscarPorNombre"/>
        <Button text="Buscar por teléfono" onAction="#onBuscarPorTelefono"/>
        <Button text="Listar todos" onAction="#onListarTodos"/>
    </HBox>

</VBox>